<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <turboFilter class="io.github.philkes.slf4j.callerinfo.SampleTurboFilter">
        <Marker>sample</Marker>
    </turboFilter>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Example log pattern including 'callerInformation' MDC parameter for Unit Tests-->
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} \(%X{callerInformation}\) - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="TRACE">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>